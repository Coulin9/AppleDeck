#!/bin/sh
# Mount only the data partition and borrow Python from a read-only system slot.
# This boot never enters SteamOS, starts Steam, or brings up a network interface.
compatibility_disk() {
    fx_find_port || prov_fail "cannot report disk operation"
    case "$1" in
        read) _ad_mode=ro,noload ;;
        write) _ad_mode=rw ;;
        *) prov_fail "unknown compatibility disk mode" ;;
    esac
    [ "$ESP_DEV" = /dev/vda1 ] && [ "$(part_dev home)" = /dev/vda8 ] \
        || prov_fail "invalid SteamOS disk layout"
    _ad_root=/tmp/compatibility-root
    mkdir -p "$_ad_root"
    _ad_mounted=
    for _ad_slot in /dev/vda4 /dev/vda5; do
        if ! mount -t btrfs -o ro,rescue=nologreplay "$_ad_slot" "$_ad_root"; then
            prov_say "could not mount $_ad_slot"
            continue
        fi
        if chroot "$_ad_root" /usr/bin/python3 --version >/dev/null 2>&1; then
            _ad_mounted=1
            break
        fi
        prov_say "Python is unavailable on $_ad_slot"
        umount "$_ad_root" || prov_fail "cannot unmount SteamOS system partition"
    done
    [ "$_ad_mounted" = 1 ] || prov_fail "cannot read the SteamOS system partition"
    mount -t ext4 -o "$_ad_mode,nosuid,nodev,noexec" /dev/vda8 "$_ad_root/home" \
        || prov_fail "cannot open the SteamOS home partition"
    mount -t tmpfs -o nosuid,nodev tmpfs "$_ad_root/run" || prov_fail "cannot prepare compatibility environment"
    mount -t devtmpfs -o nosuid devtmpfs "$_ad_root/dev" || prov_fail "cannot prepare device files"
    mkdir -p "$_ad_root/run/appledeck-compatibility" "$_ad_root/run/appledeck-tools"
    mount -t virtiofs -o nosuid,nodev,noexec appledeck-compatibility "$_ad_root/run/appledeck-compatibility" \
        || prov_fail "cannot open AppleDeck compatibility files"
    for _ad_file in steam_compatibility.py steam-compat-default steam-compatibility-offline steam-neptune-path game_patch_settings.py game_patches.py; do
        cp "$_ad_layer/usr/lib/appledeck/$_ad_file" "$_ad_root/run/appledeck-tools/" \
            || prov_fail "cannot load AppleDeck disk tool"
    done
    cp -R "$_ad_layer/usr/lib/appledeck/neptune" "$_ad_root/run/appledeck-tools/" \
        || prov_fail "cannot load Neptune payload"
    _ad_uid=$(awk -F: '$1 == "steamos" && $6 == "/home/steamos" {print $3}' "$_ad_root/etc/passwd")
    _ad_gid=$(awk -F: '$1 == "steamos" && $6 == "/home/steamos" {print $4}' "$_ad_root/etc/passwd")
    [ "${_ad_uid:-0}" -gt 0 ] && [ "${_ad_gid:-0}" -gt 0 ] \
        || prov_fail "cannot locate the SteamOS user"
    chroot "$_ad_root" /usr/bin/env -i /usr/bin/python3 /run/appledeck-tools/steam-compatibility-offline \
        "$1" "$_ad_uid" "$_ad_gid"
    _ad_result=$?
    umount "$_ad_root/home" || prov_fail "cannot flush the SteamOS home partition"
    sync
    [ "$_ad_result" = 0 ] || prov_fail "SteamOS disk operation failed"
    prov_say done
    IFS= read -r _ack < "$PROV_PORT"
    [ "$_ack" = prepared ] || prov_fail "host did not acknowledge completion"
    poweroff -f
}
