[Unit]
Description=UU accelerator plugin managed by AppleDeck
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
Environment=HOME=/home/uu/uu
Environment=XDG_DATA_HOME=/home/uu/uu/data
Environment=XDG_CONFIG_HOME=/home/uu/uu/config
Environment=STEAM_COMPAT_DATA_PATH=/home/uu/uu/compat
Environment=FEX_APP_CONFIG_LOCATION=/home/uu/uu/config
Environment=FEX_ROOTFS=/
Environment=FEX_SERVERSOCKETPATH=appledeck-uu
Environment=FEX_DISABLETELEMETRY=1
Environment=PATH=/usr/lib/appledeck/uu-runtime/bin:/usr/bin:/usr/sbin:/bin:/sbin
Environment=LD_LIBRARY_PATH=/usr/lib/appledeck/uu-runtime/lib
Environment=XTABLES_LIBDIR=/run/appledeck-uu-xtables
Environment=CURL_CA_BUNDLE=/usr/lib/appledeck/uu-runtime/ca-certificates.crt
ExecStart=/usr/lib/appledeck/uu-launch
ExecStop=/usr/lib/appledeck/uu-stop ${MAINPID}
TimeoutStopSec=60
KillMode=control-group
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
