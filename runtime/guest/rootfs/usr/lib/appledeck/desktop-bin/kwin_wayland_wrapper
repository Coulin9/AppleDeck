#!/bin/sh
# appledeck Desktop Mode (PATH of /usr/lib/appledeck/nested-desktop): startplasma-wayland
# starts KWin through kwin_wayland_wrapper; KWin's X11 window takes the display size.
exec /usr/bin/kwin_wayland_wrapper --width "${APPLEDECK_DESKTOP_WIDTH:-1280}" \
    --height "${APPLEDECK_DESKTOP_HEIGHT:-800}" --no-lockscreen "$@"
