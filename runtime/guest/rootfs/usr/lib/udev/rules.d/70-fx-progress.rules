# AppleDeck virtio-console ports.
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.progress", MODE="0666"
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.pad", MODE="0666", TAG+="systemd", ENV{SYSTEMD_WANTS}+="appledeck-pad.service"
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.telemetry", MODE="0600", TAG+="systemd", ENV{SYSTEMD_WANTS}+="appledeck-telemetry.service"
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.uu", MODE="0600", TAG+="systemd", ENV{SYSTEMD_WANTS}+="appledeck-uu.service"
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.compatibility", OWNER="steamos", MODE="0600", TAG+="systemd", ENV{SYSTEMD_WANTS}+="appledeck-compatibility.service"
SUBSYSTEM=="virtio-ports", ATTR{name}=="fx.clipboard", OWNER="steamos", MODE="0600"
